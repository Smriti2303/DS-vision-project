# Copy this file to ".env" and fill in your real values.
# ".env" is what the app actually reads — this file is just a template/example.

# Which camera to read from.
# Use "0" for your laptop webcam while testing, or a full rtsp:// URL for a real camera.
VIDEO_SOURCE=0

# A name for this camera — shows up in Supabase rows and API responses.
CAMERA_ID=camera-1

# OPTIONAL — only needed if you want the Lovable dashboard's sidebar "Detection Log"
# to update live from a real database. Leave blank to skip this (video + prompts
# still work fine without it, you just won't get the persisted log).
# Find these in your Supabase project: Settings -> API
SUPABASE_URL=
SUPABASE_KEY=